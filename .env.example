# Pulse - Fitness Dashboard Configuration

# App
#
# PIN required before anything is reachable. Leave empty and there is NO
# authentication at all — every endpoint is open to anyone who can reach the
# port. Only leave it empty on a trusted network.
# Keep the value on its own with no trailing comment, or the rest of the line
# risks becoming part of the PIN.
APP_PIN=

# Signs the session cookie. Left at the default, a random key is generated per
# process and every restart signs you out. Set a long random string
# (`openssl rand -hex 32`) to stay logged in across deploys.
APP_SECRET_KEY=change-me-to-a-random-string

# Comma-separated origins allowed to call the API cross-origin. Empty means
# same-origin only, which is what a self-hosted instance wants.
CORS_ORIGINS=

# Your timezone. The daily auto-push to your watch runs at 05:00 in this zone;
# a container left at UTC would fire it at 07:00 in central Europe.
TZ=Europe/Stockholm

# Strava API (create app at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/strava/callback

# intervals.icu (get API key at https://intervals.icu/settings)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# AI Coach - defaults to Ollama (free, local)
AI_PROVIDER=ollama  # ollama | claude | openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sync interval in minutes
SYNC_INTERVAL=15

# Smart Trainer
FTP=200  # Functional Threshold Power in watts

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/pulse.db

# --- Deployment (Debian host, docker-compose.prod.yml) ---
# Lowercase GitHub owner/repo. Images are published as
# ghcr.io/<IMAGE_OWNER>-api and ghcr.io/<IMAGE_OWNER>-web
IMAGE_OWNER=anton-jj/fitnessapp
# "latest", or a specific sha-<commit> tag to pin or roll back
IMAGE_TAG=latest
# Host port for the web UI
WEB_PORT=8080
